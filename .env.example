# Configuration aioslsk Web Interface
# Copier ce fichier en .env et remplir vos identifiants

AISLSK_HOST=0.0.0.0
AISLSK_PORT=8000
AISLSK_DEBUG=true

# Identifiants Soulseek (optionnel - utilisés comme valeur par défaut)
AISLSK_SOULSEEK_USERNAME=votre_username
AISLSK_SOULSEEK_PASSWORD=votre_password
